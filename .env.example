# Root .env for docker-compose.yml
# Copy this file to ".env" in the project root and fill in real values.
# docker-compose automatically loads a ".env" file from the same directory.

POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=postgres

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=change_me_strong_password

REDIS_PASSWORD=change_me_strong_password
