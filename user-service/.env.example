# ============ Server Configuration ============
PORT=4001
NODE_ENV=development
LOG_LEVEL=info

# ============ Database Configuration ============
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://admin:irctcpass@localhost:5433/postgres

# ============ Redis Configuration ============
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL=redis://:irctcpass@localhost:6379

# ============ CORS Configuration ============
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4001

# ============ Email Configuration ============
# Gmail SMTP settings - Use App Password (not your regular password)
# Generate app password: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password_here
MAIL_FROM="IRCTC Backend <your_email@gmail.com>"

# ============ JWT Configuration ============
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_64_character_hex_string_here
JWT_REFRESH_SECRET=your_128_character_hex_string_here

# Token expiration times
ACCESS_TOKEN_EXP=15m
REFRESH_TOKEN_EXP=7d

# Token expiration in seconds
ACCESS_TOKEN_EXP_SEC=900
REFRESH_TOKEN_EXP_SEC=604800

# Redis user session TTL in seconds (86400 = 24 hours)
REDIS_USER_TTL=86400
