# ============ Server Configuration ============
PORT=4004
NODE_ENV=development
LOG_LEVEL=info

# ============ Kafka Configuration ============
# Docker Compose exposes Kafka to local Node.js services on port 9093.
KAFKA_BROKER=localhost:9093
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-service-group

# ============ Email Configuration ============
# Create an API key at https://app.sendgrid.com/settings/api_keys.
SENDGRID_API_KEY=replace_with_your_sendgrid_api_key
# This sender must be verified in SendGrid.
MAIL_FROM=verified-sender@example.com

# ============ Frontend Configuration ============
FRONTEND_URL=http://localhost:3000
